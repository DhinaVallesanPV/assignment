# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL (local install, psycopg v3 driver) ---
DATABASE_URL=postgresql+psycopg://scrubber:CHANGE_ME@localhost:5432/financial_scrubber

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- App ---
APP_ENV=development
MAX_UPLOAD_MB=25
SCRUB_OUTPUT_DIR=output
